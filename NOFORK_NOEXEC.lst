mktemp - noexec. leaks: xstrdup+concat_path_file
more - interactive, longterm
mv - noexec. sometimes runner
nc - runner
nice - noexec. spawner
nl - runner
nohup - noexec. spawner
nproc - NOFORK
od - runner
